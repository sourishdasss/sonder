// Copy this file to Secrets.xcconfig (which is git-ignored) and fill in your key.
//
// Heads-up: anything compiled into an iOS app can be extracted from the binary. That is fine
// for personal builds and TestFlight, but for a public App Store release route Claude calls
// through a server you control instead of shipping the key.

ANTHROPIC_API_KEY = sk-ant-your-key-here
